# ── LiveKit Server ─────────────────────────────────────────────────
# Sign up free at https://cloud.livekit.io/ or self-host.
# Run `lk cloud auth` then `lk app env -w` to auto-populate these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ── Google Gemini  (https://aistudio.google.com/apikey) ──────────
GOOGLE_API_KEY=your-google-api-key
# GOOGLE_VOICE=Puck      # Puck, Charon, Kore, Fenrir, Aoede

# ── Model Provider ────────────────────────────────────────────────
# Default provider when the room name has no provider prefix.
# (run_batch.sh normally sets this per-run; the room-name prefix
#  routes each task to the right model, so one agent serves both.)
#   gemini-2.5 – Google Gemini 2.5 Live API
#   gemini-3.1 – Google Gemini 3.1 Flash Live (preview)
# LK_PROVIDER=gemini-2.5

# ── System prompt override (default: scripts/system_prompt.txt) ──
# LK_SYSTEM_PROMPT_FILE=/path/to/prompt.txt
