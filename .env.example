# Copy to .env and fill in. The only required variable is
# TT_BENCHMARK_DATA — every analysis / consensus / split / baseline
# script reads from this single root.

# Absolute path to the dataset root, i.e. the directory that contains
# one subdirectory per task_id (e.g. 100/, 101/, ...), each with
# combined_audio.wav, speaker_{1,2}_audio.wav, the three annotator
# SRTs, and metadata.json.
TT_BENCHMARK_DATA=/abs/path/to/full_delivery_with_metadata

# Optional. Where consensus / per-conversation / split outputs are
# written. Defaults to <repo>/stats_out if unset.
# STATS_DIR=/abs/path/to/tt-benchmark/stats_out

# Required by baselines/{moshi,gemini}/predict.py: roots of the cached
# ASR word-timestamp JSONs produced by each baseline's pipeline/ stage
# (layout: <dir>/<task_id>/speaker_K/{output.json,speaker_K_audio.json}).
# MOSHI_ASR_DIR=/abs/path/to/asr_results/moshi
# GEMINI_ASR_DIR=/abs/path/to/asr_results/gemini

# Required by baselines/openai_{server,semantic}_vad/predict.py — a funded
# OpenAI API key for the Realtime turn-detection baselines (shared by both).
# OPENAI_API_KEY=sk-...
